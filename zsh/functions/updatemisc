# -*- mode: shell-script -*-
# vi: set ft=shell-script :
#
# updatemisc [section ...]
#
# Update the tools that don't come from the Brewfile. With no arguments
# every section runs; pass section names to run a subset, e.g.
#   updatemisc brew
#   updatemisc prelude prezto
#
# Sections:
#   prelude  ~/.emacs.d (bbatsov/prelude checkout)
#   prezto   zprezto submodule in the dotfiles repo (relinked with rcup)
#   plugins  AI tool plugin/marketplace repos (claude CLI, codex, opencode)
#   brew     brew update/upgrade/autoremove/cleanup
#   private  greg-private-update from private-dotfiles, if defined
#
# Failures don't abort the run; they are collected and summarised at the end
# and the function returns non-zero.

emulate -L zsh
setopt local_options pipe_fail

local -a all_sections=(prelude prezto plugins brew private)
local -a want=("$@") failed
local dotfiles="${DOTFILES:-$HOME/dotfiles}"
local red=$'\e[1;31m' dim=$'\e[2m' reset=$'\e[0m'
local s

(( $#want )) || want=("${all_sections[@]}")
for s in "${want[@]}"; do
    if (( ! ${all_sections[(Ie)$s]} )); then
        print -u2 "updatemisc: unknown section '$s' (choose from: ${all_sections[*]})"
        return 2
    fi
done

_um_hdr()  { print -- "\n${red}== $1${reset}" }
_um_fail() { failed+=("$1"); print -- "  ${red}!! $1 failed${reset}" }
_um_want() { (( ${want[(Ie)$1]} )) }
_um_path() { print -- "${1/#$HOME/~}" }

# ---------------------------------------------------------------- prelude
if _um_want prelude; then
    _um_hdr "Prelude (~/.emacs.d)"
    if [[ -e $HOME/.emacs.d/.git ]]; then
        git -C "$HOME/.emacs.d" pull --ff-only 2>&1 | sed 's/^/  /' || _um_fail prelude
    elif [[ -e $HOME/.emacs.d ]]; then
        print "  skip: ~/.emacs.d exists but is not a git checkout"
    else
        curl -fsSL https://github.com/bbatsov/prelude/raw/master/utils/installer.sh | sh \
            || _um_fail prelude
    fi
fi

# ----------------------------------------------------------------- prezto
# ~/.zprezto is rcm-linked file-by-file into the dotfiles submodule, so
# update the submodule and re-run rcup so any new files get linked.
if _um_want prezto; then
    _um_hdr "Prezto ($(_um_path "$dotfiles/zprezto"))"
    if [[ -e $dotfiles/zprezto/.git ]]; then
        local before=$(git -C "$dotfiles/zprezto" rev-parse HEAD)
        if git -C "$dotfiles/zprezto" pull --ff-only 2>&1 | sed 's/^/  /' \
            && git -C "$dotfiles/zprezto" submodule update --init --recursive 2>&1 | sed 's/^/  /'; then
            if [[ $before != $(git -C "$dotfiles/zprezto" rev-parse HEAD) ]]; then
                (( $+commands[rcup] )) && rcup -q
                print "  note: zprezto submodule moved; commit the pointer in $(_um_path "$dotfiles")"
            fi
        else
            _um_fail prezto
        fi
    else
        print "  skip: $(_um_path "$dotfiles/zprezto") is not a git checkout (run: git submodule update --init)"
    fi
fi

# ---------------------------------------------------------------- plugins
if _um_want plugins; then
    _um_hdr "AI tool plugin repos"

    local -a bases=("$HOME/.codex" "$HOME/.config/opencode" "$HOME/.opencode")
    # Update marketplaces one at a time: the bare `marketplace update` does a
    # fresh shallow clone of every marketplace and hits the CLI's 120s timeout
    # on large repos (claude-mem) when GitHub is routed through a slow path.
    # Per-name updates do an incremental fetch of the existing checkout.
    local known="$HOME/.claude/plugins/known_marketplaces.json" mkt
    if (( $+commands[claude] )) && [[ -r $known ]] && (( $+commands[jq] )); then
        for mkt in $(jq -r 'keys[]' "$known"); do
            print "  claude plugin marketplace update $mkt"
            claude plugin marketplace update "$mkt" 2>&1 | sed 's/^/    /' \
                || _um_fail "plugins:marketplace:$mkt"
        done
    elif (( $+commands[claude] )); then
        print "  claude plugin marketplace update"
        claude plugin marketplace update 2>&1 | sed 's/^/    /' || _um_fail "plugins:claude-marketplaces"
    else
        # No CLI to do it for us; pull the marketplace checkouts directly.
        bases+=("$HOME/.claude/plugins/marketplaces")
    fi

    local base gitdir repo branch
    for base in "${bases[@]}"; do
        [[ -d $base ]] || continue
        while IFS= read -r gitdir; do
            repo=${gitdir%/.git}
            if ! branch=$(git -C "$repo" symbolic-ref --short -q HEAD 2>/dev/null); then
                print "  ${dim}skip (detached or broken): $(_um_path "$repo")${reset}"; continue
            fi
            if ! git -C "$repo" remote get-url origin &>/dev/null; then
                print "  ${dim}skip (no remote): $(_um_path "$repo")${reset}"; continue
            fi
            if [[ -n $(git -C "$repo" status --porcelain --untracked-files=no 2>/dev/null) ]]; then
                print "  ${dim}skip (local changes): $(_um_path "$repo")${reset}"; continue
            fi
            print "  pull $(_um_path "$repo") ($branch)"
            git -C "$repo" pull --ff-only --recurse-submodules 2>&1 | sed 's/^/    /' \
                || _um_fail "plugins:${repo:t}"
        done < <(find "$base" -maxdepth 4 \
                    \( -name .tmp -o -name node_modules -o -name cache -o -name sessions \
                       -o -name '*-backup-*' -o -name '*.bak' \) -prune \
                    -o -type d -name .git -print 2>/dev/null)
    done
fi

# ------------------------------------------------------------------- brew
if _um_want brew && (( $+commands[brew] )); then
    _um_hdr "Homebrew"
    local step
    for step in update upgrade autoremove cleanup; do
        brew $step || _um_fail "brew $step"
    done
fi

# ---------------------------------------------------------------- private
if _um_want private && (( $+functions[greg-private-update] )); then
    _um_hdr "Private packages"
    greg-private-update || _um_fail private
fi

# ---------------------------------------------------------------- summary
unfunction _um_hdr _um_fail _um_want _um_path
print
if (( $#failed )); then
    print -- "${red}updatemisc: failed: ${(j:, :)failed}${reset}"
    return 1
fi
print "updatemisc: done (${(j:, :)want})"
